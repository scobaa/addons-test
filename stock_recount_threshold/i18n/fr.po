#. module: stock_recount_threshold
#: model:ir.model,name:stock_recount_threshold.model_stock_recount_request
msgid "Solicitud de recuento por umbral"
msgstr "Demande de recomptage par seuil"

#. module: stock_recount_threshold
#: model:ir.actions.act_window,name:stock_recount_threshold.stock_recount_request_action
#: model:ir.ui.menu,name:stock_recount_threshold.menu_stock_recount_request
msgid "Solicitudes de recuento"
msgstr "Demandes de recomptage"

#. module: stock_recount_threshold
#: model_terms:ir.ui.view,arch_db:stock_recount_threshold.stock_recount_request_form_view
msgid "Solicitud de recuento"
msgstr "Demande de recomptage"

#. module: stock_recount_threshold
#: model:ir.model.fields,field_description:stock_recount_threshold.field_product_template__recount_enabled
msgid "Recuento automático activo"
msgstr "Recomptage automatique activé"

#. module: stock_recount_threshold
#: model:ir.model.fields,help:stock_recount_threshold.field_product_template__recount_enabled
msgid "Si está activo, cuando la cantidad disponible de este producto cruce el umbral definido abajo tras un picking o consumo, se generará automáticamente una solicitud de recuento."
msgstr "Si activé, lorsque la quantité disponible de ce produit franchit le seuil défini ci-dessous suite à une préparation ou une consommation, une demande de recomptage sera générée automatiquement."

#. module: stock_recount_threshold
#: model:ir.model.fields,field_description:stock_recount_threshold.field_product_template__recount_threshold_qty
msgid "Umbral de recuento"
msgstr "Seuil de recomptage"

#. module: stock_recount_threshold
#: model:ir.model.fields,help:stock_recount_threshold.field_product_template__recount_threshold_qty
msgid "Cuando la cantidad disponible (on hand) de este producto, en una ubicación dada, cae a este valor o por debajo tras un movimiento de stock, se generará una solicitud de recuento automáticamente."
msgstr "Lorsque la quantité disponible de ce produit, à un emplacement donné, descend à cette valeur ou en dessous suite à un mouvement de stock, une demande de recomptage sera générée automatiquement."

#. module: stock_recount_threshold
#: model:ir.model.fields,field_description:stock_recount_threshold.field_product_template__recount_responsible_id
msgid "Responsable del recuento"
msgstr "Responsable du recomptage"

#. module: stock_recount_threshold
#: model:ir.model.fields,help:stock_recount_threshold.field_product_template__recount_responsible_id
msgid "Usuario al que se le asignará la actividad de recuento. Si se deja vacío, se usará el responsable de la operación de stock que disparó el umbral."
msgstr "Utilisateur auquel l'activité de recomptage sera assignée. Si laissé vide, le responsable de l'opération de stock ayant déclenché le seuil sera utilisé."

#. module: stock_recount_threshold
#: model_terms:ir.ui.view,arch_db:stock_recount_threshold.product_template_form_view_recount
msgid "Recuento automático"
msgstr "Recomptage automatique"

