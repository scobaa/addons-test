<?xml version="1.0" encoding="utf-8"?>
<!-- License OPL-1 -->
<odoo>


    <!-- ================================================================
         LIST VIEW — sale.target.line (standalone / reporting)
         ================================================================ -->
    <record id="view_sale_target_line_tree" model="ir.ui.view">
        <field name="name">sale.target.line.list</field>
        <field name="model">sale.target.line</field>
        <field name="arch" type="xml">
            <list string="Target Lines"
                  decoration-danger="achievement_rate &lt; 50"
                  decoration-warning="achievement_rate &gt;= 50 and achievement_rate &lt; 80"
                  decoration-success="achievement_rate &gt;= 100">

                <field name="target_id"/>
                <field name="industry_id"/>
                <field name="year" options="{'format': 0}"/>
                <field name="month"/>
                <field name="target_amount" sum="Total Target"/>
                <field name="achieved_amount" sum="Total Achieved"/>
                <field name="gap_amount" sum="Total Gap"/>
                <field name="achievement_rate" string="Achievement (%)"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         PIVOT VIEW — sale.target.line
         ================================================================ -->
    <record id="view_sale_target_line_pivot" model="ir.ui.view">
        <field name="name">sale.target.line.pivot</field>
        <field name="model">sale.target.line</field>
        <field name="arch" type="xml">
            <pivot string="Targets by Industry &amp; Month">
                <field name="industry_id" type="row"/>
                <field name="month" type="col"/>
                <field name="target_amount" type="measure" string="Target Amount"/>
                <field name="achieved_amount" type="measure" string="Achieved Amount"/>
                <field name="achievement_rate" type="measure" string="Achievement (%)"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================
         GRAPH VIEW — sale.target.line
         ================================================================ -->
    <record id="view_sale_target_line_graph" model="ir.ui.view">
        <field name="name">sale.target.line.graph</field>
        <field name="model">sale.target.line</field>
        <field name="arch" type="xml">
            <graph string="Target vs Achieved by Industry" type="bar" stacked="false">
                <field name="industry_id" type="row"/>
                <field name="target_amount" type="measure" string="Target"/>
                <field name="achieved_amount" type="measure" string="Achieved"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         WINDOW ACTION — sale.target.line (Reporting)
         ================================================================ -->
    <record id="sale_target_line_action" model="ir.actions.act_window">
        <field name="name">Targets by Industry</field>
        <field name="res_model">sale.target.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No target lines found.
            </p>
            <p>
                Create a Sales Target Plan first and add lines
                to start tracking your industry targets.
            </p>
        </field>
    </record>

</odoo>
